{
  "name": "gamcheon-map",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/gamcheon-map.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/gamcheon-map.js"
    },
    "./style.css": "./dist/gamcheon-map.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json && node scripts/copy-model-assets.mjs",
    "build:demo": "tsc --noEmit && vite build && node scripts/copy-model-assets.mjs --demo",
    "test": "vitest run",
    "build:road-ground": "node scripts/build-road-ground.mjs",
    "build:greenhouse": "node scripts/build-greenhouse-from-plan.mjs",
    "build:beautiful-hangul": "node scripts/build-beautiful-hangul.mjs",
    "export:site": "node scripts/export-to-site.mjs",
    "pull:alleys": "node scripts/pull-site-alleys.mjs"
  },
  "dependencies": {
    "maplibre-gl": "^6.11.2",
    "polygon-clipping": "^0.15.7",
    "three": "^0.186.1"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "jsdom": "^29.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
